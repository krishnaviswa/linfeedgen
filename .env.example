# --- Auth (required) ---
APP_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string

# --- Database ---
# Local / Railway free: omit DATABASE_URL → SQLite at $DATA_DIR/studio.db
# Optional: Neon/Supabase/etc (not Railway's Postgres plugin)
# DATABASE_URL=postgresql://user:pass@host:5432/neondb

# Where PNGs and SQLite live. On Railway, mount a volume here.
DATA_DIR=./data

# --- LLM adapter (required to generate) ---
# gemini | deepseek | qwen | openrouter
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional overrides (defaults per provider)
# LLM_MODEL=gemini-2.0-flash
# LLM_BASE_URL=

# --- Cron (Railway HTTP cron) ---
CRON_SECRET=generate-another-long-random-string

# --- LinkedIn (optional; copy-paste export works without this) ---
# Create an app at https://www.linkedin.com/developers/
# Redirect URI must match exactly, e.g. https://your-app.up.railway.app/api/linkedin/callback
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback

# Public URL of this app (used by OAuth if REDIRECT_URI unset)
# APP_URL=http://localhost:3000
